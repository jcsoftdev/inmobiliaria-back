{
  "name": "inmobiliaria",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/inmobiliaria/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "dev:um": "nest start user-management --watch",
    "dev:rs": "nest start real-state-gateway --watch",
    "dev:ps": "nest start properties --watch",
    "dev:ds": "nest start data-service --watch",
    "dev:kafka": "nest start kafka-service --watch",
    "dev:all": "concurrently --names \"User,Gateway,Properties,Data,Kafka\" \"pnpm run dev:um\" \"pnpm run dev:rs\" \"pnpm run dev:ps\" \"pnpm run dev:ds\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky",
    "p:gen": "cd apps/data-service && prisma generate && cd ../..",
    "p:migrate": "cd apps/data-service && prisma migrate dev && cd ../.."
  },
  "dependencies": {
    "@grpc/grpc-js": "1.13.0",
    "@grpc/proto-loader": "0.7.13",
    "@nestjs/common": "11.0.11",
    "@nestjs/config": "4.0.1",
    "@nestjs/core": "11.0.11",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/microservices": "11.0.11",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/swagger": "11.0.6",
    "@prisma/client": "6.5.0",
    "axios": "1.8.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "kafkajs": "^2.2.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.0",
    "@eslint/js": "9.22.0",
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.0.11",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.11.9",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "6.0.2",
    "concurrently": "9.1.2",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.3",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "prisma": "6.5.0",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.6",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common$": "<rootDir>/libs/common/src",
      "^@app/common/(.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/contracts$": "<rootDir>/libs/contracts/src",
      "^@app/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@data-service/(.*)$": "<rootDir>/apps/data-service/src/$1",
      "^@gateway/(.*)$": "<rootDir>/apps/real-state-gateway/src/$1",
      "^@libs/auth": "<rootDir>/libs/auth/src/main.ts",
      "^@properties/(.*)$": "<rootDir>/apps/properties/src/$1",
      "^@user-management/(.*)$": "<rootDir>/apps/user-management/src/$1"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@swc/core",
      "prisma"
    ],
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@swc/core",
      "prisma"
    ]
  }
}