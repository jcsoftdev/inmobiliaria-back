{
  "compilerOptions": {
    "module": "ESNext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "declaration": true,
    "removeComments": true,
    "strictFunctionTypes": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/common": [
        "libs/common/src/index.ts"
      ],
      "@app/common/*": [
        "libs/common/src/*"
      ],
      "@app/config": [
        "libs/config/src/index"
      ],
      "@app/config/*": [
        "libs/config/src/*"
      ],
      "@app/contracts": [
        "libs/contracts/src/index.ts"
      ],
      "@app/contracts/*": [
        "libs/contracts/src/*"
      ],
      "@app/protos/*": [
        "libs/common/src/protos/*"
      ],
      "@app/shared": [
        "libs/shared/src/index.ts"
      ],
      "@app/shared/*": [
        "libs/shared/src/*"
      ],
      "@data-service/*": [
        "./apps/data-service/src/*"
      ],
      "@gateway/*": [
        "./apps/real-state-gateway/src/*"
      ],
      "@libs/auth": [
        "./libs/auth/src/main.ts"
      ],
      "@properties/*": [
        "./apps/properties/src/*"
      ]
    }
  }
}